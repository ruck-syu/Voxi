<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Menu-bar only: no Dock icon. -->
  <key>LSUIElement</key>
  <true/>
  <key>NSDesktopFolderUsageDescription</key>
  <string>Voxi organizes files on your Desktop when you ask it to.</string>
  <key>NSDocumentsFolderUsageDescription</key>
  <string>Voxi organizes files in Documents when you ask it to.</string>
  <key>NSDownloadsFolderUsageDescription</key>
  <string>Voxi organizes files in Downloads when you ask it to.</string>
  <key>NSRemovableVolumesUsageDescription</key>
  <string>Voxi moves files to external drives when you ask it to.</string>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Finder Items</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.item</string>
        <string>public.folder</string>
        <!-- Finder lists concrete types and these narrower families in Open With. -->
        <string>public.text</string>
        <string>public.image</string>
        <string>public.archive</string>
        <string>public.audiovisual-content</string>
        <string>public.composite-content</string>
        <string>com.adobe.pdf</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Other Files</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <!-- Wildcard extensions let Finder drop arbitrary files onto the app icon. -->
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>*</string>
      </array>
    </dict>
  </array>
  <!-- "Organize with Voxi" for files selected in Finder. -->
  <key>NSServices</key>
  <array>
    <dict>
      <key>NSMenuItem</key>
      <dict>
        <key>default</key>
        <string>Organize with Voxi</string>
      </dict>
      <key>NSMessage</key>
      <string>organizeWithVoxi</string>
      <key>NSRequiredContext</key>
      <dict/>
      <key>NSSendFileTypes</key>
      <array>
        <string>public.item</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
