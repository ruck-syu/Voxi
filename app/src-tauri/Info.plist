<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Menu-bar only: no Dock icon. -->
  <key>LSUIElement</key>
  <true/>
  <key>NSDesktopFolderUsageDescription</key>
  <string>Voxi organizes files on your Desktop when you ask it to.</string>
  <key>NSDocumentsFolderUsageDescription</key>
  <string>Voxi organizes files in Documents when you ask it to.</string>
  <key>NSDownloadsFolderUsageDescription</key>
  <string>Voxi organizes files in Downloads when you ask it to.</string>
  <key>NSRemovableVolumesUsageDescription</key>
  <string>Voxi moves files to external drives when you ask it to.</string>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Files</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <!-- Accept drops without becoming the default document handler. -->
      <string>None</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.data</string>
      </array>
    </dict>
  </array>
  <!-- "Organize with Voxi" for files selected in Finder. -->
  <key>NSServices</key>
  <array>
    <dict>
      <key>NSMenuItem</key>
      <dict>
        <key>default</key>
        <string>Organize with Voxi</string>
      </dict>
      <key>NSMessage</key>
      <string>organizeWithVoxi</string>
      <key>NSRequiredContext</key>
      <dict/>
      <key>NSSendFileTypes</key>
      <array>
        <string>public.item</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
