{
  "schema": 1,
  "version": 3,
  "minAppVersion": "0.0.0",
  "rules": [
    {
      "id": "make-one-pdf",
      "intent": "images_to_pdf",
      "pattern": "^make (1) pdf from (.+)$",
      "replace": "create $1 pdf from $2",
      "examples": [
        { "input": "make one PDF from images in Scans named receipts", "expect": "create 1 pdf from images in Scans named receipts" }
      ]
    },
    {
      "id": "break-pdf-into-pages",
      "intent": "split_pdf",
      "pattern": "^break (.+?\\.pdf|\"[^\"]+\\.pdf\"|'[^']+\\.pdf') into pages$",
      "replace": "split $1 into pages",
      "examples": [
        { "input": "break report.pdf into pages", "expect": "split report.pdf into pages" }
      ]
    },
    {
      "id": "uncompress-zip",
      "intent": "unzip",
      "pattern": "^uncompress (.+?\\.zip) into (.+)$",
      "replace": "unzip $1 into $2",
      "examples": [
        { "input": "uncompress archive.zip into Downloads/archive", "expect": "unzip archive.zip into Downloads/archive" }
      ]
    }
  ]
}
